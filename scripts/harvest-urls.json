    "https://github.com/vuejs/core/issues/new/choose",
    {
      "url": "https://github.com/vuejs/core/issues?q=is%3Aissue%20state%3Aclosed",
      "follow": { "pattern": "^https://github\\.com/vuejs/core/issues/\\d+$", "count": 3 }
    },
    {
      "url": "https://github.com/microsoft/vscode/issues",
      "follow": { "pattern": "^https://github\\.com/microsoft/vscode/issues/\\d+$", "count": 2 }
    }
  ],
  "pulls": [
    "https://github.com/vuejs/core/pulls",
    "https://github.com/vuejs/core/pulls?q=is%3Apr%20is%3Amerged",
    {
      "url": "https://github.com/vuejs/core/pulls?q=is%3Apr%20is%3Amerged",
      "follow": {
        "pattern": "^https://github\\.com/vuejs/core/pull/\\d+$",
        "count": 2,
        "suffixes": ["", "/commits", "/checks", "/files"]
      }
    },
    {
      "url": "https://github.com/cli/cli/pulls",
      "follow": { "pattern": "^https://github\\.com/cli/cli/pull/\\d+$", "count": 2, "suffixes": ["", "/files"] }
    }
  ],
  "actions": [
    "https://github.com/vuejs/core/actions",
    "https://github.com/vuejs/core/actions/workflows/ci.yml",
    "https://github.com/vuejs/core/deployments",
    "https://github.com/cli/cli/actions",
    {
      "url": "https://github.com/vuejs/core/actions",
      "follow": {
        "pattern": "^https://github\\.com/vuejs/core/actions/runs/\\d+$",
        "count": 2,
        "then": { "pattern": "^https://github\\.com/vuejs/core/actions/runs/\\d+/job/\\d+$", "count": 1 }
      }
    }
  ],
  "projects": [
    "https://github.com/orgs/github/projects/4247",
