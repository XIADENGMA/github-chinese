    "https://github.com/vuejs/core/compare",
    {
      "url": "https://github.com/vuejs/core/commits/main",
      "follow": { "pattern": "^https://github\\.com/vuejs/core/commit/[0-9a-f]{40}$", "count": 2 }
    }
  ],
  "issues": [
    "https://github.com/vuejs/core/issues",
    "https://github.com/vuejs/core/issues?q=is%3Aissue%20state%3Aclosed",
